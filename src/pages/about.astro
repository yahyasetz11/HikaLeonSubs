---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Tentang & Algoritma — HikaLeonSubs" description="Tentang HikaLeonSubs dan pipeline AI open-source yang digunakan untuk membuat subtitle Indonesia Sakurazaka46.">
  <Navbar />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <h1 class="font-display font-bold text-2xl sm:text-3xl md:text-4xl text-ink dark:text-dark-ink mb-4 sm:mb-6">Tentang HikaLeonSubs</h1>

    <div class="prose prose-neutral dark:prose-invert max-w-none font-sans text-ink dark:text-dark-ink">
      <p class="text-base sm:text-lg text-ink-muted dark:text-dark-muted leading-relaxed mb-6 sm:mb-8">
        HikaLeonSubs adalah proyek fansub yang menyediakan subtitle Indonesia untuk konten Sakurazaka46 — variety show, dokumenter, dan clip eksklusif yang sebelumnya tidak tersedia dalam bahasa Indonesia.
      </p>

      <div class="rounded-2xl border border-ground-border dark:border-dark-border bg-ground-card dark:bg-dark-card p-4 sm:p-6 mb-6 sm:mb-8">
        <h2 class="font-display font-bold text-lg sm:text-xl text-ink dark:text-dark-ink mb-3 sm:mb-4">Siapa Kami</h2>
        <p class="text-xs sm:text-sm text-ink-muted dark:text-dark-muted leading-relaxed">
          <strong class="text-ink dark:text-dark-ink">Hika</strong> dan <strong class="text-ink dark:text-dark-ink">Leon</strong> adalah dua penggemar Sakurazaka46 yang percaya bahwa konten berkualitas seharusnya bisa dinikmati oleh semua penggemar, tanpa batasan bahasa. Kami menggunakan kombinasi AI dan koreksi manual untuk menghasilkan subtitle yang akurat dan natural dalam bahasa Indonesia.
        </p>
      </div>

      <div class="rounded-2xl border border-ground-border dark:border-dark-border bg-ground-card dark:bg-dark-card p-4 sm:p-6 mb-6 sm:mb-8">
        <h2 class="font-display font-bold text-lg sm:text-xl text-ink dark:text-dark-ink mb-3 sm:mb-4">Pipeline AI Kami</h2>
        <p class="text-xs sm:text-sm text-ink-muted dark:text-dark-muted leading-relaxed mb-4">
          Kami menggunakan pipeline open-source berbasis AI untuk mempercepat proses subtitling. Pipeline ini mencakup:
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm text-ink-muted dark:text-dark-muted">
          <li class="flex items-start gap-2.5">
            <span class="mt-1 w-1.5 h-1.5 rounded-full bg-sakura-500 flex-shrink-0"></span>
            <span>Speech recognition untuk transkripsi audio Jepang</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1 w-1.5 h-1.5 rounded-full bg-sakura-500 flex-shrink-0"></span>
            <span>Machine translation Jepang → Indonesia dengan model yang dikustomisasi</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1 w-1.5 h-1.5 rounded-full bg-sakura-500 flex-shrink-0"></span>
            <span>Post-processing dan koreksi manual untuk memastikan akurasi dan naturalitas</span>
          </li>
        </ul>
        <p class="mt-4 text-xs sm:text-sm text-ink-muted dark:text-dark-muted">
          Dokumentasi lengkap pipeline tersedia di GitHub kami.
        </p>
      </div>

      <a
        href="https://github.com/yahyasetz11/HikaLeonSubs"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary w-full sm:w-auto inline-flex justify-center"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd"/>
        </svg>
        Lihat Pipeline di GitHub
      </a>
    </div>
  </main>
  <Footer />
</Base>
