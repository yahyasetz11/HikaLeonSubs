---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Carousel from '../components/Carousel.astro';
import EpisodeFeed from '../components/EpisodeFeed.astro';
import TrakteerWidget from '../components/TrakteerWidget.astro';
import Footer from '../components/Footer.astro';
import { latestEpisodes, feedEpisodes } from '../data/episodes';
---

<Base>
  <Navbar />
  <main id="main-content">
    <div class="border-b border-ground-border dark:border-dark-border">
      <Carousel episodes={latestEpisodes} />
    </div>
    <div class="flex flex-col xl:flex-row gap-8 xl:gap-6 items-start max-w-[1600px] mx-auto">
      <div class="flex-1 min-w-0 w-full overflow-hidden">
        <EpisodeFeed episodes={feedEpisodes} pageSize={9} />
      </div>
      <aside class="w-full xl:w-80 flex-shrink-0 px-4 sm:px-6 xl:pr-8 xl:pl-0 xl:pt-12 xl:sticky xl:top-6" aria-label="Dukung HikaLeonSubs">
        <TrakteerWidget />
      </aside>
    </div>
  </main>
  <Footer />
</Base>
