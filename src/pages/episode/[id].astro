---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { episodes } from '../../data/episodes';
import { parseTitle, stripTitleTags } from '../../utils/title';

export function getStaticPaths() {
  return episodes.map((ep) => ({
    params: { id: ep.id },
    props: { episode: ep },
  }));
}

const { episode } = Astro.props;
const cleanTitle = stripTitleTags(episode.episodeTitle);

const dateFormatted = new Date(episode.releaseDate).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base title={`${cleanTitle} — HikaLeonSubs`} description={episode.description ?? `Download subtitle Indonesia untuk ${cleanTitle}.`}>
  <Navbar />
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <nav class="flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-ink-muted dark:text-dark-muted mb-6 sm:mb-8 font-sans overflow-x-auto py-1 scrollbar-none" aria-label="Breadcrumb">
      <a href="/" class="hover:text-sakura-600 dark:hover:text-sakura-400 transition-colors flex-shrink-0">Beranda</a>
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
      <a href={`/shows/${episode.showSlug}`} class="hover:text-sakura-600 dark:hover:text-sakura-400 transition-colors flex-shrink-0 truncate max-w-[120px] sm:max-w-none">{episode.showName}</a>
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
      <span class="text-ink dark:text-dark-ink truncate max-w-[140px] sm:max-w-none">{cleanTitle}</span>
    </nav>

    <div class="rounded-2xl overflow-hidden border border-ground-border dark:border-dark-border bg-ground-card dark:bg-dark-card shadow-sm">
      <div class="aspect-video bg-ground-border dark:bg-dark-border relative overflow-hidden">
        <img
          src={episode.thumbnail}
          alt={`Thumbnail ${episode.showName} — ${cleanTitle}`}
          class="w-full h-full object-cover"
          loading="eager"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
        />
        <div
          class="absolute inset-0 items-center justify-center bg-gradient-to-br from-sakura-50 to-sakura-100 dark:from-sakura-900/30 dark:to-sakura-800/30"
          style="display: none;"
          aria-hidden="true"
        >
          <svg class="w-24 h-24 text-sakura-200 dark:text-sakura-800" fill="none" viewBox="0 0 80 80" aria-hidden="true">
            <circle cx="40" cy="40" r="36" stroke="currentColor" stroke-width="1.5"/>
            <path d="M40 12C40 12 24 22 24 34C24 42.837 31.163 50 40 50C48.837 50 56 42.837 56 34C56 22 40 12 40 12Z" fill="currentColor" opacity="0.4"/>
          </svg>
        </div>
      </div>

      <div class="p-4 sm:p-6 md:p-8">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
          <a href={`/shows/${episode.showSlug}`} class="show-badge">{episode.showName}</a>
          <span class="text-xs font-display font-medium text-ink-muted dark:text-dark-muted uppercase tracking-wide">{episode.episodeNumber}</span>
        </div>

        <h1 class="font-display font-bold text-xl sm:text-2xl md:text-3xl lg:text-4xl text-ink dark:text-dark-ink leading-tight mb-2">
          {parseTitle(episode.episodeTitle).map((part) =>
            part.isTagged ? (
              <span class="title-tag-gold">{part.text}</span>
            ) : (
              <span>{part.text}</span>
            )
          )}
        </h1>

        {episode.episodeSubtitle && (
          <p class="text-sm sm:text-base md:text-lg text-ink-muted dark:text-dark-muted font-sans leading-snug mb-3 sm:mb-4">
            {episode.episodeSubtitle}
          </p>
        )}

        {episode.description && (
          <p class="text-sm sm:text-base text-ink-muted dark:text-dark-muted leading-relaxed mb-5 sm:mb-6">
            {episode.description}
          </p>
        )}

        <div class="flex flex-wrap items-center gap-4 sm:gap-6 py-3 sm:py-4 border-y border-ground-border dark:border-dark-border mb-5 sm:mb-6">
          <div>
            <p class="text-[11px] sm:text-xs text-ink-light dark:text-dark-muted mb-0.5 uppercase tracking-wide font-sans">Tanggal Rilis</p>
            <time datetime={episode.releaseDate} class="text-xs sm:text-sm font-display font-medium text-ink dark:text-dark-ink">
              {dateFormatted}
            </time>
          </div>
          <div>
            <p class="text-[11px] sm:text-xs text-ink-light dark:text-dark-muted mb-0.5 uppercase tracking-wide font-sans">Show</p>
            <a href={`/shows/${episode.showSlug}`} class="text-xs sm:text-sm font-display font-medium text-sakura-600 dark:text-sakura-400 hover:underline">
              {episode.showName}
            </a>
          </div>
        </div>

        <a
          href={episode.downloadUrl}
          class="btn-primary w-full sm:w-auto justify-center text-sm sm:text-base px-6 py-3"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
          </svg>
          Go to Trakteer
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
