---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { episodes } from '../../data/episodes';
import { parseTitle, stripTitleTags } from '../../utils/title';

export function getStaticPaths() {
  return episodes.map((ep) => ({
    params: { id: ep.id },
    props: { episode: ep },
  }));
}

const { episode } = Astro.props;
const cleanTitle = stripTitleTags(episode.episodeTitle);

const releaseDate = new Date(episode.releaseDate);
const dateFormatted = releaseDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const isSokomagattara = episode.showId === 'sokomagattara';
const oneWeekAfterRelease = new Date(releaseDate);
oneWeekAfterRelease.setDate(oneWeekAfterRelease.getDate() + 7);
const today = new Date();
const mediafireUnlocked = isSokomagattara && today >= oneWeekAfterRelease;
const mediafireUnlockDateFormatted = oneWeekAfterRelease.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const images = [
  { src: episode.thumbnail, alt: `Thumbnail ${cleanTitle}` },
  ...(episode.previewImage1 ? [{ src: episode.previewImage1, alt: `Scene 1 — ${cleanTitle}` }] : []),
  ...(episode.previewImage2 ? [{ src: episode.previewImage2, alt: `Scene 2 — ${cleanTitle}` }] : []),
];
---

<Base title={`${cleanTitle} — HikaLeonSubs`} description={episode.description ?? `Download subtitle Indonesia untuk ${cleanTitle}.`}>
  <Navbar />
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <nav class="flex items-center gap-1.5 text-xs text-ink-muted dark:text-dark-muted mb-8 font-sans overflow-x-auto py-1 scrollbar-none" aria-label="Breadcrumb">
      <a href="/" class="hover:text-sakura-600 dark:hover:text-sakura-400 transition-colors flex-shrink-0 whitespace-nowrap">Beranda</a>
      <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
      <a href={`/shows/${episode.showSlug}`} class="hover:text-sakura-600 dark:hover:text-sakura-400 transition-colors flex-shrink-0 whitespace-nowrap truncate max-w-[140px] sm:max-w-none">{episode.showName}</a>
      <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
      <span class="text-ink dark:text-dark-ink truncate max-w-[160px] sm:max-w-none whitespace-nowrap">{cleanTitle}</span>
    </nav>

    <div class="flex flex-col lg:grid lg:grid-cols-[1fr_380px] gap-6 lg:gap-10 lg:items-start">

      <div class="space-y-2 lg:space-y-6 order-1 lg:order-none" id="gallery-col">
          <div class="relative rounded-2xl overflow-hidden bg-ground-border dark:bg-dark-border aspect-video shadow-md" id="gallery-main">
            <img
              id="gallery-main-img"
              src={images[0].src}
              alt={images[0].alt}
              class="w-full h-full object-cover transition-opacity duration-300"
              loading="eager"
              onerror="this.style.opacity='0'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent pointer-events-none"></div>
          </div>

          {images.length > 1 && (
            <div class="grid grid-cols-3 gap-2" id="gallery-thumbs">
              {images.map((img, i) => (
                <button
                  class={`gallery-thumb relative rounded-xl overflow-hidden aspect-video bg-ground-border dark:bg-dark-border ring-2 transition-all duration-150 ${i === 0 ? 'ring-sakura-500' : 'ring-transparent hover:ring-sakura-300 dark:hover:ring-sakura-700'}`}
                  data-src={img.src}
                  data-alt={img.alt}
                  data-index={i}
                  aria-label={img.alt}
                >
                  <img
                    src={img.src}
                    alt={img.alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.style.opacity='0.2'"
                  />
                  <div class={`absolute inset-0 bg-black/0 hover:bg-black/10 transition-colors duration-150 ${i === 0 ? 'bg-black/0' : ''}`}></div>
                </button>
              ))}
              {images.length === 1 && (
                <>
                  <div class="relative rounded-xl overflow-hidden aspect-video bg-ground-border dark:bg-dark-border opacity-40 flex items-center justify-center">
                    <svg class="w-6 h-6 text-ink-light dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                  </div>
                  <div class="relative rounded-xl overflow-hidden aspect-video bg-ground-border dark:bg-dark-border opacity-40 flex items-center justify-center">
                    <svg class="w-6 h-6 text-ink-light dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                  </div>
                </>
              )}
              {images.length === 2 && (
                <div class="relative rounded-xl overflow-hidden aspect-video bg-ground-border dark:bg-dark-border opacity-40 flex items-center justify-center">
                  <svg class="w-6 h-6 text-ink-light dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                </div>
              )}
            </div>
          )}
        

        {episode.description && (
          <div class="hidden lg:block bg-ground-card dark:bg-dark-card border border-ground-border dark:border-dark-border rounded-2xl p-5 sm:p-6">
            <h2 class="font-display font-semibold text-xs uppercase tracking-widest text-ink-muted dark:text-dark-muted mb-3">Sinopsis</h2>
            <p class="text-sm sm:text-base text-ink dark:text-dark-ink leading-relaxed">{episode.description}</p>
          </div>
        )}
      </div>

      <aside class="space-y-5 lg:sticky lg:top-24 order-2 lg:order-none">

        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <a href={`/shows/${episode.showSlug}`} class="show-badge">{episode.showName}</a>
            {episode.episodeNumber && (
              <span class="text-xs font-display font-medium text-ink-muted dark:text-dark-muted uppercase tracking-wide">{episode.episodeNumber}</span>
            )}
          </div>
          <h1 class="font-display font-bold text-2xl sm:text-3xl text-ink dark:text-dark-ink leading-tight mb-2">
            {parseTitle(episode.episodeTitle).map((part) =>
              part.isTagged ? (
                <span class="title-tag-gold">{part.text}</span>
              ) : (
                <span>{part.text}</span>
              )
            )}
          </h1>
          {episode.episodeSubtitle && (
            <p class="text-sm text-ink-muted dark:text-dark-muted leading-snug">{episode.episodeSubtitle}</p>
          )}
        </div>

        <div class="flex items-center gap-5 py-3.5 border-y border-ground-border dark:border-dark-border">
          <div>
            <p class="text-[10px] text-ink-light dark:text-dark-muted mb-0.5 uppercase tracking-widest font-sans">Rilis</p>
            <time datetime={episode.releaseDate} class="text-sm font-display font-semibold text-ink dark:text-dark-ink">
              {dateFormatted}
            </time>
          </div>
          <div class="w-px h-8 bg-ground-border dark:bg-dark-border" aria-hidden="true"></div>
          <div>
            <p class="text-[10px] text-ink-light dark:text-dark-muted mb-0.5 uppercase tracking-widest font-sans">Show</p>
            <a href={`/shows/${episode.showSlug}`} class="text-sm font-display font-semibold text-sakura-600 dark:text-sakura-400 hover:underline">
              {episode.showName}
            </a>
          </div>
        </div>

        <div class="space-y-3">
          <h2 class="font-display font-semibold text-xs uppercase tracking-widest text-ink-muted dark:text-dark-muted">Unduh</h2>

          <div class="download-card group" data-state={
            isSokomagattara
              ? (mediafireUnlocked ? 'available' : 'locked-date')
              : 'supporter-only'
          }>
            <div class="download-card-inner">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="download-icon download-icon-mediafire flex-shrink-0">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="font-display font-semibold text-sm text-ink dark:text-dark-ink leading-none mb-0.5">Mediafire</p>
                    <p class="text-xs text-ink-muted dark:text-dark-muted">Softsub (.srt / .ass)</p>
                  </div>
                </div>
                <div class="flex-shrink-0 pt-0.5">
                  {isSokomagattara && mediafireUnlocked && episode.mediafireUrl ? (
                    <span class="availability-badge availability-badge-free">Publik</span>
                  ) : isSokomagattara && !mediafireUnlocked ? (
                    <span class="availability-badge availability-badge-locked">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                      Terkunci
                    </span>
                  ) : (
                    <span class="availability-badge availability-badge-supporter">Khusus Supporter</span>
                  )}
                </div>
              </div>

              {isSokomagattara && !mediafireUnlocked && (
                <p class="text-xs text-ink-muted dark:text-dark-muted mt-2.5 leading-relaxed">
                  Link publik tersedia mulai <span class="font-semibold text-ink dark:text-dark-ink">{mediafireUnlockDateFormatted}</span>. Untuk akses lebih awal, dukung kami di Trakteer.
                </p>
              )}

              {!isSokomagattara && (
                <p class="text-xs text-ink-muted dark:text-dark-muted mt-2.5 leading-relaxed">
                  Tersedia eksklusif bagi Supporter di Trakteer.
                </p>
              )}

              {isSokomagattara && mediafireUnlocked && episode.mediafireUrl && (
                <a
                  href={episode.mediafireUrl}
                  class="download-btn download-btn-mediafire mt-3"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Unduh dari Mediafire
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              )}
            </div>
          </div>

          <div class="download-card">
            <div class="download-card-inner">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="download-icon download-icon-trakteer flex-shrink-0">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="font-display font-semibold text-sm text-ink dark:text-dark-ink leading-none mb-0.5">Trakteer</p>
                    <p class="text-xs text-ink-muted dark:text-dark-muted">Hardsub (video .mp4)</p>
                  </div>
                </div>
                <span class="availability-badge availability-badge-supporter flex-shrink-0 pt-0.5">Supporter</span>
              </div>
              <p class="text-xs text-ink-muted dark:text-dark-muted mt-2.5 leading-relaxed">
                Video dengan subtitle yang sudah tertanam. Dukung kami dan dapatkan akses langsung.
              </p>
              {episode.trakteerUrl ? (
                <a
                  href={episode.trakteerUrl}
                  class="download-btn download-btn-trakteer mt-3"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
                  Dukung di Trakteer
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              ) : (
                <a
                  href={episode.downloadUrl !== '#' ? episode.downloadUrl : 'https://trakteer.id'}
                  class="download-btn download-btn-trakteer mt-3"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
                  Dukung di Trakteer
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              )}
            </div>
          </div>

          <div class="download-card">
            <div class="download-card-inner">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="download-icon download-icon-raw flex-shrink-0">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="font-display font-semibold text-sm text-ink dark:text-dark-ink leading-none mb-0.5">RAW MP4</p>
                    <p class="text-xs text-ink-muted dark:text-dark-muted">Video tanpa subtitle</p>
                  </div>
                </div>
                <span class="availability-badge availability-badge-supporter flex-shrink-0 pt-0.5">Supporter</span>
              </div>
              <p class="text-xs text-ink-muted dark:text-dark-muted mt-2.5 leading-relaxed">
                File video asli tanpa subtitle, untuk digabungkan dengan file subtitle secara lokal.
              </p>
              {episode.rawMp4Url ? (
                <a
                  href={episode.rawMp4Url}
                  class="download-btn download-btn-raw mt-3"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg>
                  Unduh RAW MP4
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              ) : (
                <span class="download-btn download-btn-raw-disabled mt-3 cursor-not-allowed opacity-50 select-none" aria-disabled="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg>
                  Belum tersedia
                </span>
              )}
            </div>
          </div>
        </div>

        <p class="text-[11px] text-ink-light dark:text-dark-muted leading-relaxed pt-1">
          Subtitle dibuat dengan AI pipeline open-source. <a href="/about" class="underline underline-offset-2 hover:text-sakura-600 dark:hover:text-sakura-400 transition-colors">Pelajari caranya →</a>
        </p>
      </aside>

      {episode.description && (
        <div class="lg:hidden order-3 bg-ground-card dark:bg-dark-card border border-ground-border dark:border-dark-border rounded-2xl p-5">
          <h2 class="font-display font-semibold text-xs uppercase tracking-widest text-ink-muted dark:text-dark-muted mb-3">Sinopsis</h2>
          <p class="text-sm text-ink dark:text-dark-ink leading-relaxed">{episode.description}</p>
        </div>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .download-card {
    background: var(--tw-bg-opacity, 1);
    @apply bg-ground-card dark:bg-dark-card border border-ground-border dark:border-dark-border rounded-2xl overflow-hidden transition-shadow duration-200;
  }
  .download-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .dark .download-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }
  .download-card-inner {
    @apply p-4;
  }

  .download-icon {
    @apply w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0;
  }
  .download-icon-mediafire {
    @apply bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400;
  }
  .download-icon-trakteer {
    @apply bg-sakura-50 text-sakura-600 dark:bg-sakura-900/30 dark:text-sakura-400;
  }
  .download-icon-raw {
    @apply bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400;
  }

  .availability-badge {
    @apply inline-flex items-center gap-1 text-[10px] font-display font-semibold px-2 py-0.5 rounded-full uppercase tracking-wide whitespace-nowrap;
  }
  .availability-badge-free {
    @apply bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400;
  }
  .availability-badge-locked {
    @apply bg-ground-border text-ink-muted dark:bg-dark-border dark:text-dark-muted;
  }
  .availability-badge-supporter {
    @apply bg-sakura-50 text-sakura-700 dark:bg-sakura-900/40 dark:text-sakura-300;
  }

  .download-btn {
    @apply inline-flex items-center gap-2 w-full justify-center font-display font-semibold text-xs px-4 py-2.5 rounded-xl transition-all duration-150;
  }
  .download-btn-mediafire {
    @apply bg-blue-500 hover:bg-blue-600 text-white;
  }
  .download-btn-mediafire:hover {
    box-shadow: 0 3px 10px rgba(59,130,246,0.35);
    transform: translateY(-1px);
  }
  .download-btn-trakteer {
    @apply bg-sakura-500 hover:bg-sakura-600 text-white;
  }
  .download-btn-trakteer:hover {
    box-shadow: 0 3px 10px rgba(232,99,138,0.4);
    transform: translateY(-1px);
  }
  .download-btn-raw {
    @apply bg-amber-500 hover:bg-amber-600 text-white;
  }
  .download-btn-raw:hover {
    box-shadow: 0 3px 10px rgba(245,158,11,0.35);
    transform: translateY(-1px);
  }
  .download-btn-raw-disabled {
    @apply inline-flex items-center gap-2 w-full justify-center font-display font-semibold text-xs px-4 py-2.5 rounded-xl bg-ground-border dark:bg-dark-border text-ink-muted dark:text-dark-muted;
  }
</style>

<script>
  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      const alt = thumb.dataset.alt;

      if (mainImg && src) {
        mainImg.style.opacity = '0';
        setTimeout(() => {
          mainImg.src = src;
          mainImg.alt = alt ?? '';
          mainImg.style.opacity = '1';
        }, 150);
      }

      thumbs.forEach((t) => {
        t.classList.remove('ring-sakura-500');
        t.classList.add('ring-transparent');
      });
      thumb.classList.remove('ring-transparent');
      thumb.classList.add('ring-sakura-500');
    });
  });
</script>
