---
import { episodes, shows } from '../data/episodes';
import { stripTitleTags } from '../utils/title';

const serializedEpisodes = JSON.stringify(
  episodes.map((ep) => ({
    id: ep.id,
    showSlug: ep.showSlug,
    showName: ep.showName,
    episodeTitle: stripTitleTags(ep.episodeTitle),
    episodeSubtitle: ep.episodeSubtitle ?? '',
    episodeNumber: ep.episodeNumber,
    releaseDate: ep.releaseDate,
    thumbnail: ep.thumbnail,
    description: ep.description ?? '',
  }))
);
---

<header class="sticky top-0 z-50 bg-ground/90 dark:bg-dark-ground/90 backdrop-blur-md border-b border-ground-border dark:border-dark-border">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="HikaLeonSubs beranda">
      <img src="/logo-black.png" alt="HikaLeonSubs" class="h-8 w-auto dark:hidden" />
      <img src="/logo-white.png" alt="HikaLeonSubs" class="h-8 w-auto hidden dark:block" />
      <span class="font-display font-bold text-lg tracking-tight text-ink dark:text-dark-ink group-hover:text-sakura-600 dark:group-hover:text-sakura-400 transition-colors duration-150">
        HikaLeonSubs
      </span>
    </a>

    <!-- Desktop right side -->
    <div class="hidden md:flex items-center gap-1">
      <!-- Nav links + inline search input (crossfade) -->
      <div class="relative flex items-center">
        <!-- Nav links layer -->
        <div
          id="nav-links"
          class="flex items-center gap-1 transition-[opacity,transform] duration-220 ease-out"
          style="transition-timing-function: cubic-bezier(0.16,1,0.3,1);"
        >
          <a href="/" class="font-display font-medium text-sm px-3 py-2 rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150">
            Beranda
          </a>
          <a href="/shows" class="font-display font-medium text-sm px-3 py-2 rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150">
            Semua Show
          </a>
          <a href="/about" class="font-display font-medium text-sm px-3 py-2 rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150">
            Tentang
          </a>
          <a href="/algorithm" class="font-display font-medium text-sm px-3 py-2 rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150">
            Algoritma
          </a>
          <button
            id="nav-search-btn"
            type="button"
            aria-label="Cari episode"
            class="w-9 h-9 flex items-center justify-center rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
          </button>
        </div>

        <!-- Search input layer (fades in over nav links) -->
        <div
          id="nav-search-bar"
          aria-hidden="true"
          class="absolute inset-y-0 right-0 flex items-center gap-2 pointer-events-none opacity-0"
          style="min-width: 320px; transition: opacity 0.22s cubic-bezier(0.16,1,0.3,1), transform 0.22s cubic-bezier(0.16,1,0.3,1); transform: translateX(6px);"
        >
          <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <input
            id="nav-search-input"
            type="text"
            placeholder="Cari episode..."
            autocomplete="off"
            class="flex-1 bg-transparent font-sans text-sm text-ink dark:text-dark-ink placeholder-ink-muted dark:placeholder-dark-muted outline-none min-w-0"
          />
          <button
            id="nav-search-close"
            type="button"
            aria-label="Tutup pencarian"
            class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150 flex-shrink-0"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div class="w-px h-5 bg-ground-border dark:bg-dark-border mx-1" aria-hidden="true"></div>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle tema gelap/terang"
        class="w-9 h-9 flex items-center justify-center rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150"
      >
        <svg id="icon-sun" class="hidden dark:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <svg id="icon-moon" class="block dark:hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>
    </div>

    <div class="flex md:hidden items-center gap-1.5">
      <!-- search button mobile -->
      <button
        id="nav-search-btn-mobile"
        type="button"
        aria-label="Cari episode"
        class="w-10 h-10 flex items-center justify-center rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </button>

      <button
        id="theme-toggle-mobile"
        type="button"
        aria-label="Toggle tema gelap/terang"
        class="w-10 h-10 flex items-center justify-center rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150"
      >
        <svg class="hidden dark:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <svg class="block dark:hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="w-10 h-10 flex items-center justify-center rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150"
      >
        <svg id="menu-icon-open" class="block w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="menu-icon-close" class="hidden w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile search overlay (full-width, shown below nav row on mobile) -->
  <div
    id="nav-search-bar-mobile"
    aria-hidden="true"
    class="md:hidden absolute inset-x-0 top-0 h-16 flex items-center gap-3 px-4 pointer-events-none opacity-0"
    style="transition: opacity 0.22s cubic-bezier(0.16,1,0.3,1), transform 0.22s cubic-bezier(0.16,1,0.3,1); transform: translateY(-4px); background: inherit;"
  >
    <svg class="w-5 h-5 text-ink-muted dark:text-dark-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
    </svg>
    <input
      id="nav-search-input-mobile"
      type="text"
      placeholder="Cari episode..."
      autocomplete="off"
      class="flex-1 bg-transparent font-sans text-sm text-ink dark:text-dark-ink placeholder-ink-muted dark:placeholder-dark-muted outline-none"
    />
    <button
      id="nav-search-close-mobile"
      type="button"
      aria-label="Tutup pencarian"
      class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-all duration-150 flex-shrink-0"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Live results overlay -->
  <div
    id="nav-search-overlay"
    class="hidden absolute left-0 right-0 top-16 z-50 mx-4 sm:mx-6 lg:mx-8 rounded-xl border border-ground-border dark:border-dark-border bg-ground-card dark:bg-dark-card shadow-xl overflow-hidden"
    data-episodes={serializedEpisodes}
  >
    <div id="nav-search-results" class="divide-y divide-ground-border dark:divide-dark-border"></div>
    <div id="nav-search-see-all" class="hidden px-4 py-2.5 border-t border-ground-border dark:border-dark-border">
      <a
        id="nav-search-see-all-link"
        href="/search"
        class="flex items-center justify-between text-sm font-display font-semibold text-sakura-600 dark:text-sakura-400 hover:text-sakura-700 dark:hover:text-sakura-300 transition-colors"
      >
        <span id="nav-search-see-all-text">Lihat semua hasil</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
    <div id="nav-search-empty" class="hidden px-4 py-5 text-sm text-ink-muted dark:text-dark-muted font-sans"></div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-ground-border dark:border-dark-border bg-ground/95 dark:bg-dark-ground/95 backdrop-blur-md px-4 pt-2 pb-4 space-y-1 shadow-lg animate-fade-in"
  >
    <a
      href="/"
      class="mobile-nav-link flex items-center justify-between font-display font-medium text-base px-3.5 py-3 rounded-xl text-ink dark:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-colors"
    >
      <span>Beranda</span>
      <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </a>
    <a
      href="/shows"
      class="mobile-nav-link flex items-center justify-between font-display font-medium text-base px-3.5 py-3 rounded-xl text-ink dark:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-colors"
    >
      <span>Semua Show</span>
      <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </a>
    <a
      href="/about"
      class="mobile-nav-link flex items-center justify-between font-display font-medium text-base px-3.5 py-3 rounded-xl text-ink dark:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-colors"
    >
      <span>Tentang</span>
      <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </a>
    <a
      href="/algorithm"
      class="mobile-nav-link flex items-center justify-between font-display font-medium text-base px-3.5 py-3 rounded-xl text-ink dark:text-dark-ink hover:bg-ground-border dark:hover:bg-dark-border transition-colors"
    >
      <span>Algoritma</span>
      <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </a>
  </div>
</header>

<script>
  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  const menuBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function toggleMenu(force?: boolean) {
    if (!mobileMenu || !menuBtn) return;
    const isOpen = typeof force === 'boolean' ? force : mobileMenu.classList.contains('hidden');

    if (isOpen) {
      mobileMenu.classList.remove('hidden');
      menuBtn.setAttribute('aria-expanded', 'true');
      iconOpen?.classList.add('hidden');
      iconOpen?.classList.remove('block');
      iconClose?.classList.remove('hidden');
      iconClose?.classList.add('block');
    } else {
      mobileMenu.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconOpen?.classList.add('block');
      iconClose?.classList.add('hidden');
      iconClose?.classList.remove('block');
    }
  }

  menuBtn?.addEventListener('click', () => toggleMenu());

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggleMenu(false);
  });

  // ── Navbar Search ──────────────────────────────────────────────
  (function () {
    const isMobile = () => window.innerWidth < 768;

    const navLinks = document.getElementById('nav-links');
    const searchBarDesktop = document.getElementById('nav-search-bar');
    const searchInputDesktop = document.getElementById('nav-search-input') as HTMLInputElement | null;
    const closeBtnDesktop = document.getElementById('nav-search-close');

    const searchBarMobile = document.getElementById('nav-search-bar-mobile');
    const searchInputMobile = document.getElementById('nav-search-input-mobile') as HTMLInputElement | null;
    const closeBtnMobile = document.getElementById('nav-search-close-mobile');

    const searchOverlay = document.getElementById('nav-search-overlay');
    const resultsContainer = document.getElementById('nav-search-results');
    const seeAllWrap = document.getElementById('nav-search-see-all');
    const seeAllLink = document.getElementById('nav-search-see-all-link');
    const seeAllText = document.getElementById('nav-search-see-all-text');
    const emptyMsg = document.getElementById('nav-search-empty');

    const rawData = searchOverlay?.dataset.episodes ?? '[]';
    let allEpisodes: any[] = [];
    try { allEpisodes = JSON.parse(rawData); } catch {}

    let isOpen = false;

    function getActiveInput(): HTMLInputElement | null {
      return isMobile() ? searchInputMobile : searchInputDesktop;
    }

    function highlightMatch(text: string, query: string) {
      if (!query || !text) return text;
      const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${escaped})`, 'gi');
      return text.replace(regex, '<mark class="search-highlight">$1</mark>');
    }

    function scoreEpisodes(q: string) {
      const lq = q.toLowerCase();
      const scored: { ep: any; score: number }[] = [];
      for (const ep of allEpisodes) {
        let score = 0;
        if (ep.episodeTitle.toLowerCase().includes(lq)) score += 3;
        if (ep.episodeSubtitle && ep.episodeSubtitle.toLowerCase().includes(lq)) score += 2;
        if (ep.showName.toLowerCase().includes(lq)) score += 2;
        if (ep.episodeNumber.toLowerCase().includes(lq)) score += 2;
        if (ep.description && ep.description.toLowerCase().includes(lq)) score += 1;
        if (score > 0) scored.push({ ep, score });
      }
      scored.sort((a, b) => b.score !== a.score ? b.score - a.score : b.ep.releaseDate.localeCompare(a.ep.releaseDate));
      return scored;
    }

    function formatDate(d: string) {
      try {
        return new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
      } catch { return d; }
    }

    function renderResults(query: string) {
      if (!resultsContainer || !searchOverlay) return;
      const q = query.trim();
      if (q.length < 3) {
        searchOverlay.classList.add('hidden');
        return;
      }
      const scored = scoreEpisodes(q);
      const top5 = scored.slice(0, 5);

      resultsContainer.innerHTML = '';

      const wasHidden = searchOverlay.classList.contains('hidden');
      searchOverlay.classList.remove('hidden');
      if (wasHidden) {
        searchOverlay.style.opacity = '0';
        searchOverlay.style.transform = 'translateY(-6px)';
        searchOverlay.style.transition = 'opacity 0.2s cubic-bezier(0.16,1,0.3,1), transform 0.2s cubic-bezier(0.16,1,0.3,1)';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            searchOverlay.style.opacity = '1';
            searchOverlay.style.transform = 'translateY(0)';
          });
        });
      }

      if (top5.length === 0) {
        if (emptyMsg) {
          emptyMsg.classList.remove('hidden');
          emptyMsg.textContent = `Tidak ada hasil untuk '${q}'`;
        }
        if (seeAllWrap) seeAllWrap.classList.add('hidden');
        return;
      }

      if (emptyMsg) emptyMsg.classList.add('hidden');

      top5.forEach(({ ep }) => {
        const card = document.createElement('a');
        card.href = `/shows/${ep.showSlug}/${ep.id}`;
        card.className = 'flex items-center gap-3 px-4 py-3 hover:bg-ground-border dark:hover:bg-dark-border transition-colors duration-100 group';
        card.innerHTML = `
          <img src="${ep.thumbnail}" alt="" class="w-12 h-9 object-cover rounded-md flex-shrink-0 bg-ground-border dark:bg-dark-border" loading="lazy" />
          <div class="flex-1 min-w-0">
            <p class="text-sm font-display font-semibold text-ink dark:text-dark-ink truncate leading-snug">${highlightMatch(ep.episodeTitle, q)}</p>
            ${ep.episodeSubtitle ? `<p class="text-xs text-ink-muted dark:text-dark-muted truncate mt-0.5">${highlightMatch(ep.episodeSubtitle, q)}</p>` : ''}
            <p class="text-xs text-ink-light dark:text-dark-muted mt-0.5">${formatDate(ep.releaseDate)}</p>
          </div>
        `;
        resultsContainer.appendChild(card);
      });

      if (seeAllWrap && seeAllLink && seeAllText) {
        seeAllWrap.classList.remove('hidden');
        const url = `/search?q=${encodeURIComponent(q)}`;
        seeAllLink.setAttribute('href', url);
        seeAllText.textContent = `Lihat semua ${scored.length} hasil →`;
      }
    }

    function animateIn(el: HTMLElement) {
      el.style.transition = 'opacity 0.22s cubic-bezier(0.16,1,0.3,1), transform 0.22s cubic-bezier(0.16,1,0.3,1)';
      el.classList.remove('pointer-events-none');
      el.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          el.style.opacity = '1';
          el.style.transform = el === searchBarDesktop ? 'translateX(0)' : 'translateY(0)';
        });
      });
    }

    function animateOut(el: HTMLElement, resetTransform: string) {
      el.style.transition = 'opacity 0.16s cubic-bezier(0.7,0,0.84,0), transform 0.16s cubic-bezier(0.7,0,0.84,0)';
      el.style.opacity = '0';
      el.style.transform = resetTransform;
      el.classList.add('pointer-events-none');
      el.setAttribute('aria-hidden', 'true');
    }

    let openTimer: ReturnType<typeof setTimeout>;
    let closeTimer: ReturnType<typeof setTimeout>;

    function openSearch() {
      clearTimeout(closeTimer);
      clearTimeout(openTimer);
      isOpen = true;
      if (isMobile()) {
        if (searchBarMobile) animateIn(searchBarMobile);
        setTimeout(() => getActiveInput()?.focus(), 50);
      } else {
        if (navLinks) {
          navLinks.style.transition = 'opacity 0.14s cubic-bezier(0.7,0,0.84,0), transform 0.14s cubic-bezier(0.7,0,0.84,0)';
          navLinks.style.opacity = '0';
          navLinks.style.transform = 'translateX(-4px)';
          navLinks.style.pointerEvents = 'none';
        }
        openTimer = setTimeout(() => {
          if (!isOpen) return;
          if (searchBarDesktop) animateIn(searchBarDesktop);
          getActiveInput()?.focus();
        }, 120);
      }
    }

    function closeSearch() {
      clearTimeout(openTimer);
      clearTimeout(closeTimer);
      isOpen = false;
      if (searchBarMobile) {
        animateOut(searchBarMobile, 'translateY(-4px)');
        if (searchInputMobile) searchInputMobile.value = '';
      }
      if (searchBarDesktop) {
        animateOut(searchBarDesktop, 'translateX(6px)');
        if (searchInputDesktop) searchInputDesktop.value = '';
        closeTimer = setTimeout(() => {
          if (isOpen) return;
          if (navLinks) {
            navLinks.style.transition = 'opacity 0.2s cubic-bezier(0.16,1,0.3,1), transform 0.2s cubic-bezier(0.16,1,0.3,1)';
            navLinks.style.opacity = '1';
            navLinks.style.transform = 'translateX(0)';
            navLinks.style.pointerEvents = '';
          }
        }, 100);
      }
      if (searchOverlay) searchOverlay.classList.add('hidden');
    }

    let debounceTimer: ReturnType<typeof setTimeout>;
    function onInput(input: HTMLInputElement) {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => renderResults(input.value), 200);
    }

    function onKeydown(e: KeyboardEvent, input: HTMLInputElement) {
      if (e.key === 'Enter') {
        const q = input.value.trim();
        if (q.length >= 3) {
          window.location.href = `/search?q=${encodeURIComponent(q)}`;
          closeSearch();
        }
      }
    }

    searchInputDesktop?.addEventListener('input', () => onInput(searchInputDesktop));
    searchInputDesktop?.addEventListener('keydown', (e) => onKeydown(e, searchInputDesktop));
    searchInputMobile?.addEventListener('input', () => onInput(searchInputMobile));
    searchInputMobile?.addEventListener('keydown', (e) => onKeydown(e, searchInputMobile));

    closeBtnDesktop?.addEventListener('click', closeSearch);
    closeBtnMobile?.addEventListener('click', closeSearch);

    document.getElementById('nav-search-btn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      openSearch();
    });
    document.getElementById('nav-search-btn-mobile')?.addEventListener('click', (e) => {
      e.stopPropagation();
      openSearch();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeSearch();
    });

    document.addEventListener('click', (e) => {
      if (!isOpen) return;
      const target = e.target as Node;
      const inDesktop = searchBarDesktop?.contains(target);
      const inMobile = searchBarMobile?.contains(target);
      const inOverlay = searchOverlay?.contains(target);
      if (!inDesktop && !inMobile && !inOverlay) closeSearch();
    });
  })();
</script>
