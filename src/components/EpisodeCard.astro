---
import type { Episode } from '../data/episodes';
import { stripTitleTags } from '../utils/title';

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;

const cleanTitle = stripTitleTags(episode.episodeTitle);

const dateFormatted = new Date(episode.releaseDate).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const cardId = `card-${episode.id}`;
---

<div class="episode-card-wrapper" id={cardId}>
  <div class="episode-card-shell">

    <div class="card-layer card-front group relative flex gap-0 rounded-2xl overflow-hidden bg-ground-card dark:bg-dark-card border border-ground-border dark:border-dark-border transition-shadow duration-200 ease-out hover:shadow-[0_8px_24px_rgba(232,99,138,0.10),0_2px_8px_rgba(0,0,0,0.05)] dark:hover:shadow-[0_8px_24px_rgba(232,99,138,0.18),0_2px_8px_rgba(0,0,0,0.3)]">
      <a
        href={`/episode/${episode.id}`}
        class="relative flex-shrink-0 w-28 sm:w-44 md:w-52 overflow-hidden bg-ground-border dark:bg-dark-border rounded-l-2xl"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src={episode.thumbnail}
          alt=""
          class="episode-thumb w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
          loading="lazy"
          decoding="async"
        />
        <div
          class="episode-fallback absolute inset-0 hidden items-center justify-center bg-gradient-to-br from-sakura-50 to-sakura-100 dark:from-sakura-900/30 dark:to-sakura-800/30"
          aria-hidden="true"
        >
          <svg class="w-10 h-10 text-sakura-300 dark:text-sakura-700" fill="none" viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
            <path d="M24 8C24 8 16 13 16 20C16 24.418 19.582 28 24 28C28.418 28 32 24.418 32 20C32 13 24 8 24 8Z" fill="currentColor" opacity="0.4"/>
            <path d="M24 14C24 14 20 17 20 20C20 22.209 21.791 24 24 24C26.209 24 28 22.209 28 20C28 17 24 14 24 14Z" fill="currentColor" opacity="0.7"/>
          </svg>
        </div>
      </a>

      <div class="flex flex-col justify-between flex-1 min-w-0 p-3 sm:p-5">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-1.5 mb-1.5 sm:mb-2.5">
            <a
              href={`/shows/${episode.showSlug}`}
              class="show-badge"
              onclick="event.stopPropagation()"
            >
              {episode.showName}
            </a>
          </div>

          <a
            href={`/episode/${episode.id}`}
            class="block font-display font-bold text-sm sm:text-xl md:text-2xl leading-snug text-ink dark:text-dark-ink hover:text-sakura-600 dark:hover:text-sakura-400 transition-colors duration-150 line-clamp-2 mb-1"
          >
            {cleanTitle}
          </a>

          {episode.episodeSubtitle && (
            <p class="hidden sm:block text-sm sm:text-base text-ink-muted dark:text-dark-muted font-sans leading-snug line-clamp-2 mt-1">
              {episode.episodeSubtitle}
            </p>
          )}
        </div>

        <div class="flex items-center justify-between gap-2 mt-2 pt-2 sm:mt-3 sm:pt-3 border-t border-ground-border dark:border-dark-border">
          <time
            datetime={episode.releaseDate}
            class="text-xs text-ink-light/70 dark:text-dark-muted/60 font-sans"
          >
            {dateFormatted}
          </time>

          <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
            {episode.description && (
              <button
                type="button"
                class="flip-btn inline-flex items-center gap-1.5 font-display font-medium text-xs text-ink-muted dark:text-dark-muted hover:text-sakura-600 dark:hover:text-sakura-400 transition-colors duration-150 border border-ground-border dark:border-dark-border rounded-lg px-3 py-1.5"
                aria-label={`Lihat detail ${cleanTitle}`}
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" />
                </svg>
                Details
              </button>
            )}
            <a
              href={episode.downloadUrl}
              class="btn-primary !px-3 !py-1.5 !text-xs"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Trakteer untuk ${cleanTitle}`}
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
              </svg>
              Trakteer
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="card-layer card-back rounded-2xl bg-ground-card dark:bg-dark-card border border-sakura-200 dark:border-sakura-800/60">
      <div class="flex flex-col h-full p-5 sm:p-6">
        <div class="flex items-start justify-between gap-3 mb-3">
          <p class="text-sm text-ink-muted dark:text-dark-muted font-sans leading-relaxed line-clamp-3 flex-1 min-w-0">
            {episode.description}
          </p>
          <button
            type="button"
            class="flip-btn flex-shrink-0 w-8 h-8 rounded-full bg-ground dark:bg-dark-ground border border-ground-border dark:border-dark-border flex items-center justify-center text-ink-muted dark:text-dark-muted hover:text-sakura-600 dark:hover:text-sakura-400 hover:border-sakura-300 dark:hover:border-sakura-700 transition-all duration-150"
            aria-label="Tutup detail"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="flex items-center justify-between gap-3 mt-auto pt-3 border-t border-ground-border dark:border-dark-border">
          <time datetime={episode.releaseDate} class="text-xs text-ink-light/70 dark:text-dark-muted/60 font-sans">
            {dateFormatted}
          </time>
          <a
            href={episode.downloadUrl}
            class="btn-primary !px-3 !py-1.5 !text-xs flex-shrink-0"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Trakteer untuk ${cleanTitle}`}
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
            </svg>
            Trakteer
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .episode-card-shell {
    position: relative;
  }

  .card-layer {
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-front {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    visibility: visible;
  }

  .card-back {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateX(12px);
    pointer-events: none;
    visibility: hidden;
  }

  .episode-card-wrapper.is-flipped .card-front {
    opacity: 0;
    transform: translateX(-12px);
    pointer-events: none;
    visibility: hidden;
  }

  .episode-card-wrapper.is-flipped .card-back {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-layer {
      transition: opacity 0.15s linear;
    }
    .card-front,
    .card-back {
      transform: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>('.episode-thumb').forEach((img) => {
    const fallback = img.nextElementSibling as HTMLElement | null;
    if (!fallback || !fallback.classList.contains('episode-fallback')) return;
    const show = () => { img.style.display = 'none'; fallback.style.display = 'flex'; };
    if (img.complete && img.naturalWidth === 0) { show(); }
    else { img.addEventListener('error', show); }
  });

  document.querySelectorAll<HTMLElement>('.episode-card-wrapper').forEach((wrapper) => {
    wrapper.querySelectorAll<HTMLButtonElement>('.flip-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        wrapper.classList.toggle('is-flipped');
      });
    });
  });
</script>
